	function w:_Keybind(parent, cfg)
		cfg = cfg or {}
		local mode = cfg.Mode or "Press"
		local row = create("Frame", {
			Size = UDim2.new(1, 0, 0, 28),
			BackgroundTransparency = 1,
			Parent = parent,
		})
		local nameLabel = create("TextLabel", {
			Size = UDim2.new(1, -96, 1, 0),
			BackgroundTransparency = 1,
			Text = cfg.Name or "Keybind",
			Font = Library.Theme.Font,
			TextSize = 13,
			TextColor3 = Library.Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		reg(nameLabel, "TextColor3", "Text")

		local btn = create("TextButton", {
			Size = UDim2.fromOffset(86, 24),
			Position = UDim2.new(1, -86, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = Library.Theme.Bg3,
			Text = cfg.Default or "None",
			Font = Library.Theme.Font,
			TextSize = 12,
			TextColor3 = Library.Theme.Text,
			AutoButtonColor = false,
			Parent = row,
		})
		corner(btn, Library.Theme.RadiusSm)

		local key = cfg.Default
		local active = false
		local api = {}

		local function renderActive()
			if mode == "Toggle" and active then
				tween(btn, 0.15, { BackgroundColor3 = Library.Theme.Primary })
			else
				tween(btn, 0.15, { BackgroundColor3 = Library.Theme.Bg3 })
			end
		end
		onTheme(renderActive)

		function api:Get() return key end
		function api:Set(v, silent)
			key = v
			btn.Text = (v and tostring(v)) or "None"
			if cfg.Flag then w.Flags[cfg.Flag] = key end
			if cfg.Callback and not silent then task.spawn(cfg.Callback, key) end
		end

		local captureConn
		track(btn.MouseButton1Click:Connect(function()
			btn.Text = "..."
			captureConn = track(UserInputService.InputBegan:Connect(function(input, gpe)
				if gpe then return end
				if input.UserInputType == Enum.UserInputType.Keyboard
					or input.UserInputType == Enum.UserInputType.MouseButton then
					local name = (input.KeyCode ~= Enum.KeyCode.Unknown)
						and input.KeyCode.Name
						or tostring(input.UserInputType)
					api:Set(name)
					if captureConn then captureConn:Disconnect(); captureConn = nil end
				end
			end))
		end))

		-- runtime behaviour by mode
		if mode == "Toggle" then
			track(UserInputService.InputBegan:Connect(function(input, gpe)
				if gpe then return end
				if input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode.Name == key then
					active = not active
					renderActive()
					if cfg.Callback then task.spawn(cfg.Callback, active) end
				end
			end))
		elseif mode == "Hold" then
			track(UserInputService.InputBegan:Connect(function(input, gpe)
				if gpe then return end
				if input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode.Name == key then
					if cfg.Callback then task.spawn(cfg.Callback, true) end
				end
			end))
			track(UserInputService.InputEnded:Connect(function(input)
				if input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode.Name == key then
					if cfg.Callback then task.spawn(cfg.Callback, false) end
				end
			end))
		else
			track(UserInputService.InputBegan:Connect(function(input, gpe)
				if gpe then return end
				if input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode.Name == key then
					if cfg.Callback then task.spawn(cfg.Callback, key) end
				end
			end))
		end

		api:Set(key, true)
		renderActive()
		decorate(row, cfg, parent)
		if cfg.Flag then w.Options[cfg.Flag] = api end
		return api
	end

