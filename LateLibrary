	-- Keep the window fully on screen ---------------------------
	function w:ClampToScreen(margin)
		margin = margin or 20
		local cam = workspace.CurrentCamera
		local vp = (cam and cam.ViewportSize) or Vector2.new(1920, 1080)
		local scale = math.max(w.Scale.Scale, 0.01)
		local absPos = w.Main.AbsolutePosition
		local absSize = w.Main.AbsoluteSize
		local minX, minY = margin, margin
		local maxX = math.max(minX, vp.X - absSize.X - margin)
		local maxY = math.max(minY, vp.Y - absSize.Y - margin)
		local dx, dy = 0, 0
		if absPos.X < minX then dx = minX - absPos.X
		elseif absPos.X > maxX then dx = maxX - absPos.X end
		if absPos.Y < minY then dy = minY - absPos.Y
		elseif absPos.Y > maxY then dy = maxY - absPos.Y end
		if dx ~= 0 or dy ~= 0 then
			w.Main.Position = w.Main.Position + UDim2.fromOffset(dx / scale, dy / scale)
		end
	end

	-- Snap to nearest screen edge on release --------------------
	function w:SnapToEdges()
		local cam = workspace.CurrentCamera
		local vp = (cam and cam.ViewportSize) or Vector2.new(1920, 1080)
		local scale = math.max(w.Scale.Scale, 0.01)
		local absPos = w.Main.AbsolutePosition
		local absSize = w.Main.AbsoluteSize
		local margin, threshold = 20, 26
		local targetX, targetY = absPos.X, absPos.Y
		local snapped = false
		if math.abs(absPos.X - margin) < threshold then targetX = margin; snapped = true end
		if math.abs((absPos.X + absSize.X) - (vp.X - margin)) < threshold then
			targetX = vp.X - margin - absSize.X; snapped = true
		end
		if math.abs(absPos.Y - margin) < threshold then targetY = margin; snapped = true end
		if math.abs((absPos.Y + absSize.Y) - (vp.Y - margin)) < threshold then
			targetY = vp.Y - margin - absSize.Y; snapped = true
		end
		if snapped then
			local dx = (targetX - absPos.X) / scale
			local dy = (targetY - absPos.Y) / scale
			tween(w.Main, 0.16, { Position = w.Main.Position + UDim2.fromOffset(dx, dy) })
		end
	end

	-- Window dragging (via central Drag manager) ----------------
	track(bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			local startMouse = UserInputService:GetMouseLocation()
			local startPos = w.Main.Position
			local sc = w.Scale.Scale
			Drag.begin({
				move = function(x, y)
					local dx = (x - startMouse.X) / sc
					local dy = (y - startMouse.Y) / sc
					w.Main.Position = UDim2.new(
						startPos.X.Scale, startPos.X.Offset + dx,
						startPos.Y.Scale, startPos.Y.Offset + dy
					)
					w:ClampToScreen()
				end,
				stop = function() w:SnapToEdges() end,
			})
		end
	end))

	-- Resize handles (8 directions) -----------------------------
	local MIN_W, MIN_H = 440, 300
	local function beginResize(dir)
		return function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			local startMouse = UserInputService:GetMouseLocation()
			local absPos = w.Main.AbsolutePosition
			local absSize = w.Main.AbsoluteSize
			local L0, T0 = absPos.X, absPos.Y
			local R0, B0 = absPos.X + absSize.X, absPos.Y + absSize.Y
			Drag.begin({
				move = function(x, y)
					local ddx = x - startMouse.X
					local ddy = y - startMouse.Y
					local cam = workspace.CurrentCamera
					local vp = (cam and cam.ViewportSize) or Vector2.new(1920, 1080)
					local sc = math.max(w.Scale.Scale, 0.01)
					local rootOffX = vp.X * (1 - sc) / 2
					local rootOffY = vp.Y * (1 - sc) / 2

					local L, T, R, B = L0, T0, R0, B0
					if dir:find("r") then R = R0 + ddx end
					if dir:find("l") then L = L0 + ddx end
					if dir:find("b") then B = B0 + ddy end
					if dir:find("t") then T = T0 + ddy end

					local minW, minH = MIN_W * sc, MIN_H * sc
					if dir:find("l") and (R - L) < minW then L = R - minW end
					if dir:find("r") and (R - L) < minW then R = L + minW end
					if dir:find("t") and (B - T) < minH then T = B - minH end
					if dir:find("b") and (B - T) < minH then B = T + minH end

					local newW, newH = R - L, B - T
					local cx, cy = (L + R) / 2, (T + B) / 2
					w.Main.Size = UDim2.fromOffset(newW / sc, newH / sc)
					w.Main.Position = UDim2.fromOffset((cx - rootOffX) / sc, (cy - rootOffY) / sc)
				end,
				stop = function() w:ClampToScreen() end,
			})
		end
	end

	local function resizeHandle(dir, size, position)
