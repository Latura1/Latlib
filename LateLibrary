------------------------------------------------------------
-- Instance helpers
------------------------------------------------------------
local function create(className, props)
	local inst = Instance.new(className)
	for k, v in pairs(props or {}) do
		inst[k] = v
	end
	return inst
end

local function corner(parent, radius)
	return create("UICorner", { CornerRadius = radius or Library.Theme.Corner, Parent = parent })
end

local function stroke(parent, color, thickness)
	return create("UIStroke", {
		Color = color or Library.Theme.Outline,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

local function pad(parent, px)
	return create("UIPadding", {
		PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px),
		Parent = parent,
	})
end

local function tween(inst, time, goal)
	local t = TweenService:Create(
		inst,
		TweenInfo.new(time or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		goal
	)
	t:Play()
	return t
end

------------------------------------------------------------
-- GUI parent resolution (Executor -> CoreGui, Studio -> PlayerGui)
------------------------------------------------------------
local function resolveParent()
	if gethui then
		local ok, hui = pcall(gethui)
		if ok and hui then return hui end
	end
	if RunService:IsStudio() then
		return Players.LocalPlayer:WaitForChild("PlayerGui")
	end
	local ok, core = pcall(function() return game:GetService("CoreGui") end)
	if ok and core then return core end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

------------------------------------------------------------
-- Window
------------------------------------------------------------
function Library.new(config)
	config = config or {}
	local w = { Flags = {}, Tabs = {}, Options = {} }
	local fullSize = config.Size or UDim2.fromOffset(520, 340)

	local connections = {}
	local function track(conn)
		connections[#connections + 1] = conn
		return conn
	end

	w.Gui = create("ScreenGui", {
		Name = "LunarUI",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
		Parent = resolveParent(),
	})

	w.Main = create("Frame", {
		Name = "Main",
		Size = fullSize,
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Library.Theme.Background,
		BorderSizePixel = 0,
		Parent = w.Gui,
	})
	corner(w.Main)
	stroke(w.Main)

	-- Title bar -------------------------------------------------
	local bar = create("Frame", {
		Name = "TitleBar",
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = Library.Theme.Surface,
		BorderSizePixel = 0,
		Active = true,
		Parent = w.Main,
	})
	corner(bar)

	create("TextLabel", {
		Size = UDim2.new(1, -90, 1, 0),
		Position = UDim2.fromOffset(12, 0),
		BackgroundTransparency = 1,
		Text = config.Title or "Lunar UI",
		Font = Library.Theme.FontBold,
		TextSize = 14,
		TextColor3 = Library.Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = bar,
	})

	-- Body ------------------------------------------------------
	local body = create("Frame", {
		Size = UDim2.new(1, 0, 1, -36),
		Position = UDim2.fromOffset(0, 36),
		BackgroundTransparency = 1,
		Parent = w.Main,
	})

	w.Sidebar = create("Frame", {
		Size = UDim2.new(0, 130, 1, 0),
		BackgroundColor3 = Library.Theme.Surface,
		BorderSizePixel = 0,
		Parent = body,
	})
	create("UIListLayout", {
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = w.Sidebar,
	})
	pad(w.Sidebar, 6)

	w.Content = create("Frame", {
		Size = UDim2.new(1, -130, 1, 0),
		Position = UDim2.fromOffset(130, 0),
		BackgroundTransparency = 1,
		Parent = body,
	})

	-- Window buttons --------------------------------------------
	local function barButton(text, xOffset, color)
		local b = create("TextButton", {
			Size = UDim2.fromOffset(24, 24),
			Position = UDim2.new(1, xOffset, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = Library.Theme.SurfaceAlt,
			Text = text,
			Font = Library.Theme.FontBold,
			TextSize = 14,
			TextColor3 = color or Library.Theme.Subtext,
			AutoButtonColor = false,
			Parent = bar,
		})
		corner(b, UDim.new(0, 6))
		return b
	end
	local minBtn   = barButton("-", -64)
	local closeBtn = barButton("x", -34, Color3.fromRGB(255, 120, 120))

	local minimized = false
	track(minBtn.MouseButton1Click:Connect(function()
		minimized = not minimized
		body.Visible = not minimized
		local goal = minimized
			and UDim2.new(fullSize.X.Scale, fullSize.X.Offset, 0, 36)
			or fullSize
		tween(w.Main, 0.18, { Size = goal })
	end))
	track(closeBtn.MouseButton1Click:Connect(function() w:Unload() end))

	-- Dragging --------------------------------------------------
	local dragging, dragStart, startPos
	track(bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging  = true
			dragStart = input.Position
			startPos  = w.Main.Position
			track(input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end))
		end
	end))
	track(UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			local d = input.Position - dragStart
			w.Main.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y
			)
		end
	end))

	-- Tabs ------------------------------------------------------
	function w:Tab(name)
		local btn = create("TextButton", {
			Name = (name or "Tab") .. "Btn",
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundColor3 = Library.Theme.Accent,
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Parent = w.Sidebar,
		})
		corner(btn, UDim.new(0, 6))

		local label = create("TextLabel", {
			Size = UDim2.new(1, -20, 1, 0),
			Position = UDim2.fromOffset(10, 0),
			BackgroundTransparency = 1,
			Text = name,
			Font = Library.Theme.Font,
			TextSize = 14,
			TextColor3 = Library.Theme.Subtext,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = btn,
		})

		local page = create("ScrollingFrame", {
			Name = (name or "Page") .. "Page",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 4,
			ScrollBarImageColor3 = Library.Theme.Outline,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Visible = false,
			Parent = w.Content,
		})
		create("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = page,
		})
		pad(page, 8)

		local tab = { Button = btn, Label = label, Page = page }

		function tab:Select()
			for _, other in ipairs(w.Tabs) do
				other.Page.Visible = false
				other.Button.BackgroundTransparency = 1
				other.Label.TextColor3 = Library.Theme.Subtext
			end
			page.Visible = true
			btn.BackgroundTransparency = 0
			label.TextColor3 = Library.Theme.Text
		end

		function tab:Section(sectionName)
			return w:_Section(page, sectionName)
		end

		track(btn.MouseButton1Click:Connect(function() tab:Select() end))

		table.insert(w.Tabs, tab)
		if #w.Tabs == 1 then tab:Select() end
		return tab
	end

	-- Section ---------------------------------------------------
	function w:_Section(parent, name)
		local frame = create("Frame", {
			Name = (name or "Section") .. "Section",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = Library.Theme.Surface,
			BorderSizePixel = 0,
			Parent = parent,
		})
		corner(frame, UDim.new(0, 8))
		stroke(frame)

		create("TextLabel", {
			Size = UDim2.new(1, 0, 0, 28),
			Position = UDim2.fromOffset(10, 0),
			BackgroundTransparency = 1,
			Text = name,
			Font = Library.Theme.FontBold,
			TextSize = 13,
			TextColor3 = Library.Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = frame,
		})

		local holder = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			Position = UDim2.fromOffset(0, 28),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Parent = frame,
		})
		create("UIListLayout", {
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = holder,
		})
		pad(holder, 6)

		local section = {}
		function section:Toggle(cfg)          return w:_Toggle(holder, cfg) end
		function section:Button(cfg)          return w:_Button(holder, cfg) end
		function section:Slider(cfg)          return w:_Slider(holder, cfg) end
		function section:Dropdown(cfg)        return w:_Dropdown(holder, cfg) end
		function section:TextBox(cfg)         return w:_TextBox(holder, cfg) end
		function section:Keybind(cfg)         return w:_Keybind(holder, cfg) end
		function section:ColorPicker(cfg)     return w:_ColorPicker(holder, cfg) end
		function section:Label(cfg)           return w:_Label(holder, cfg) end
		function section:Paragraph(cfg)       return w:_Paragraph(holder, cfg) end
		function section:UnloadButton(cfg)    return w:_UnloadButton(holder, cfg) end
		function section:ConfigManager(cfg)   return w:_ConfigManager(section, cfg) end
		return section
	end

	-- Toggle ----------------------------------------------------
	function w:_Toggle(parent, cfg)
		cfg = cfg or {}
		local row = create("Frame", {
			Size = UDim2.new(1, 0, 0, 28),
			BackgroundTransparency = 1,
			Parent = parent,
		})
		create("TextLabel", {
			Size = UDim2.new(1, -60, 1, 0),
			BackgroundTransparency = 1,
			Text = cfg.Name or "Toggle",
			Font = Library.Theme.Font,
			TextSize = 13,
			TextColor3 = Library.Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})

		local switch = create("TextButton", {
			Size = UDim2.fromOffset(38, 18),
			Position = UDim2.new(1, -38, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = Library.Theme.SurfaceAlt,
			Text = "",
			AutoButtonColor = false,
			Parent = row,
		})
		corner(switch, UDim.new(1, 0))

		local knob = create("Frame", {
			Size = UDim2.fromOffset(14, 14),
			Position = UDim2.fromOffset(2, 2),
			BackgroundColor3 = Color3.fromRGB(200, 200, 210),
			BorderSizePixel = 0,
			Parent = switch,
		})
		corner(knob, UDim.new(1, 0))

		local state = cfg.Default and true or false
		local function render()
			if state then
				tween(switch, 0.15, { BackgroundColor3 = Library.Theme.Accent })
				tween(knob, 0.15, { Position = UDim2.fromOffset(22, 2) })
			else
				tween(switch, 0.15, { BackgroundColor3 = Library.Theme.SurfaceAlt })
				tween(knob, 0.15, { Position = UDim2.fromOffset(2, 2) })
			end
		end
		render()

		local api = {}
		function api:Set(value, silent)
			state = value and true or false
			render()
			if cfg.Flag then w.Flags[cfg.Flag] = state end
			if cfg.Callback and not silent then task.spawn(cfg.Callback, state) end
		end
		function api:Get() return state end

		track(switch.MouseButton1Click:Connect(function() api:Set(not state) end))
		if cfg.Flag then w.Flags[cfg.Flag] = state; w.Options[cfg.Flag] = api end
		return api
	end

	-- Button ----------------------------------------------------
	function w:_Button(parent, cfg)
		cfg = cfg or {}
		local base = cfg.Color or Library.Theme.SurfaceAlt
		local hover = cfg.HoverColor
			or (cfg.Color and cfg.Color:Lerp(Color3.new(0, 0, 0), 0.18))
			or Library.Theme.AccentDim

		local btn = create("TextButton", {
			Size = UDim2.new(1, 0, 0, 28),
			BackgroundColor3 = base,
			Text = cfg.Name or "Button",
			Font = Library.Theme.Font,
			TextSize = 13,
			TextColor3 = cfg.TextColor or Library.Theme.Text,
			AutoButtonColor = false,
			Parent = parent,
		})
		corner(btn, UDim.new(0, 6))
		track(btn.MouseEnter:Connect(function()
			tween(btn, 0.12, { BackgroundColor3 = hover })
		end))
		track(btn.MouseLeave:Connect(function()
			tween(btn, 0.12, { BackgroundColor3 = base })
		end))
		track(btn.MouseButton1Click:Connect(function()
			if cfg.Callback then task.spawn(cfg.Callback) end
		end))
		return btn
	end

	function w:_UnloadButton(parent, cfg)
		cfg = cfg or {}
		return w:_Button(parent, {
			Name = cfg.Name or "Unload UI",
			Color = cfg.Color or Library.Theme.Danger,
			HoverColor = cfg.HoverColor or Library.Theme.DangerHi,
			Callback = function() w:Unload() end,
		})
	end

	-- Slider ----------------------------------------------------
	function w:_Slider(parent, cfg)
		cfg = cfg or {}
		local min      = cfg.Min or 0
		local max      = cfg.Max or 100
		local decimals = cfg.Decimals or 0
		local suffix   = cfg.Suffix or ""
		local value    = cfg.Default or min

		-- ganze Zeile ist Hitbox → überall greifbar
		local row = create("Frame", {
			Size = UDim2.new(1, 0, 0, 40),
			BackgroundTransparency = 1,
			Active = true,
			Parent = parent,
		})
		create("TextLabel", {
			Size = UDim2.new(1, -50, 0, 18),
			BackgroundTransparency = 1,
			Text = cfg.Name or "Slider",
			Font = Library.Theme.Font,
			TextSize = 13,
			TextColor3 = Library.Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		local valueLabel = create("TextLabel", {
			Size = UDim2.new(0, 50, 0, 18),
			Position = UDim2.new(1, -50, 0, 0),
			BackgroundTransparency = 1,
			Text = "",
			Font = Library.Theme.Font,
			TextSize = 13,
			TextColor3 = Library.Theme.Subtext,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = row,
		})

		local track = create("Frame", {
			Size = UDim2.new(1, 0, 0, 8),
			Position = UDim2.fromOffset(0, 26),
			BackgroundColor3 = Library.Theme.SurfaceAlt,
			BorderSizePixel = 0,
			Active = false,
			Parent = row,
		})
		corner(track, UDim.new(1, 0))

		local fill = create("Frame", {
			Size = UDim2.new(0, 0, 1, 0),
			BackgroundColor3 = Library.Theme.Accent,
			BorderSizePixel = 0,
			Parent = track,
		})
		corner(fill, UDim.new(1, 0))

		local knob = create("Frame", {
			Size = UDim2.fromOffset(14, 14),
			Position = UDim2.new(0, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Library.Theme.Text,
			BorderSizePixel = 0,
			Parent = track,
		})
		corner(knob, UDim.new(1, 0))

		local function fmt(v)
			return string.format("%." .. decimals .. "f", v) .. suffix
		end
		local function render()
			local alpha = (max > min) and (value - min) / (max - min) or 0
			fill.Size     = UDim2.new(alpha, 0, 1, 0)
			knob.Position = UDim2.new(alpha, 0, 0.5, 0)
			valueLabel.Text = fmt(value)
		end

		local api = {}
		function api:Set(v, silent)
			v = math.clamp(tonumber(v) or min, min, max)
			value = v
			render()
			if cfg.Flag then w.Flags[cfg.Flag] = value end
			if cfg.Callback and not silent then task.spawn(cfg.Callback, value) end
		end
		function api:Get() return value end

		local isDragging = false
		local function updateFromX(x)
			local rel = (x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
			rel = math.clamp(rel, 0, 1)
			local raw = min + rel * (max - min)
			if decimals == 0 then
				raw = math.floor(raw + 0.5)
			else
				local mult = 10 ^ decimals
				raw = math.floor(raw * mult + 0.5) / mult
			end
			api:Set(raw)
		end

		track(row.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				isDragging = true
				updateFromX(input.Position.X)
			end
		end))
		track(UserInputService.InputChanged:Connect(function(input)
			if not isDragging then return end
			if input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch then
				updateFromX(input.Position.X)
			end
		end))
		track(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				isDragging = false
			end
		end))

		render()
		if cfg.Flag then w.Flags[cfg.Flag] = value; w.Options[cfg.Flag] = api end
		return api
	end

	-- Dropdown --------------------------------------------------
	function w:_Dropdown(parent, cfg)
		cfg = cfg or {}
		local multi = cfg.Multi and true or false
		local options = cfg.Options or {}
		local selected
		local optionButtons = {}

		if multi then
			selected = {}
			if type(cfg.Default) == "table" then
				for _, v in ipairs(cfg.Default) do selected[v] = true end
			end
		else
			selected = { value = cfg.Default }
		end

		local container = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Parent = parent,
		})
		create("UIListLayout", { Padding = UDim.new(0, 4), Parent = container })

		local header = create("TextButton", {
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundColor3 = Library.Theme.SurfaceAlt,
			Text = "",
			AutoButtonColor = false,
			Parent = container,
		})
		corner(header, UDim.new(0, 6))

		local title = create("TextLabel", {
			Size = UDim2.new(1, -30, 1, 0),
			Position = UDim2.fromOffset(10, 0),
			BackgroundTransparency = 1,
			Text = cfg.Name or "Dropdown",
			Font = Library.Theme.Font,
			TextSize = 13,
			TextColor3 = Library.Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = header,
		})
		local arrow = create("TextLabel", {
			Size = UDim2.fromOffset(20, 20),
			Position = UDim2.new(1, -24, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundTransparency = 1,
			Text = "v",
			Font = Library.Theme.FontBold,
			TextSize = 12,
			TextColor3 = Library.Theme.Subtext,
			Parent = header,
		})

		local list = create("ScrollingFrame", {
			Size = UDim2.new(1, 0, 0, 0),
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = Library.Theme.Outline,
			BackgroundColor3 = Library.Theme.Background,
			BorderSizePixel = 0,
			Visible = false,
			Parent = container,
		})
		corner(list, UDim.new(0, 6))
		stroke(list)
		create("UIListLayout", { Padding = UDim.new(0, 2), Parent = list })
		pad(list, 4)

		local api = {}

		local function currentDisplay()
			if multi then
				local parts = {}
				for _, v in ipairs(options) do
					if selected[v] then table.insert(parts, tostring(v)) end
				end
				return (#parts > 0) and table.concat(parts, ", ") or (cfg.Placeholder or "Select...")
			end
			return (selected.value ~= nil) and tostring(selected.value) or (cfg.Placeholder or "Select...")
		end

		local function refresh()
			title.Text = currentDisplay()
			if cfg.Flag then w.Flags[cfg.Flag] = api:Get() end
		end

		local function clearOptions()
			for _, ob in ipairs(optionButtons) do ob:Destroy() end
			optionButtons = {}
		end

		local function buildOptions()
			clearOptions()
			for _, opt in ipairs(options) do
				local ob = create("TextButton", {
					Size = UDim2.new(1, 0, 0, 24),
					BackgroundColor3 = Library.Theme.SurfaceAlt,
					BackgroundTransparency = 1,
					Text = "   " .. tostring(opt),
					Font = Library.Theme.Font,
					TextSize = 13,
					TextColor3 = Library.Theme.Text,
					TextXAlignment = Enum.TextXAlignment.Left,
					AutoButtonColor = false,
					Parent = list,
				})
				corner(ob, UDim.new(0, 4))
				track(ob.MouseEnter:Connect(function() tween(ob, 0.1, { BackgroundTransparency = 0 }) end))
				track(ob.MouseLeave:Connect(function() tween(ob, 0.1, { BackgroundTransparency = 1 }) end))
				track(ob.MouseButton1Click:Connect(function()
					if multi then
						selected[opt] = not selected[opt]
					else
						selected.value = opt
						list.Visible = false
						list.Size = UDim2.new(1, 0, 0, 0)
						arrow.Text = "v"
					end
					refresh()
					if cfg.Callback then task.spawn(cfg.Callback, api:Get()) end
				end))
				table.insert(optionButtons, ob)
			end
		end

		function api:Get()
			if multi then
				local t = {}
				for _, v in ipairs(options) do
					if selected[v] then table.insert(t, v) end
				end
				return t
			end
			return selected.value
		end

		function api:Set(value, silent)
			if multi then
				selected = {}
				if type(value) == "table" then
					for _, v in ipairs(value) do selected[v] = true end
				end
			else
				selected = { value = value }
			end
			refresh()
			if cfg.Callback and not silent then task.spawn(cfg.Callback, api:Get()) end
		end

		function api:SetOptions(newOptions, keepSelection)
			options = newOptions or {}
			if not keepSelection then
				selected = multi and {} or { value = nil }
			end
			buildOptions()
			if list.Visible then
				list.Size = UDim2.new(1, 0, 0, math.min(#options * 26 + 8, 140))
			end
			refresh()
		end

		buildOptions()
		refresh()

		track(header.MouseButton1Click:Connect(function()
			list.Visible = not list.Visible
			list.Size = list.Visible
				and UDim2.new(1, 0, 0, math.min(#options * 26 + 8, 140))
				or UDim2.new(1, 0, 0, 0)
			arrow.Text = list.Visible and "^" or "v"
		end))

		if cfg.Flag then w.Flags[cfg.Flag] = api:Get(); w.Options[cfg.Flag] = api end
		return api
	end

