			knob.Position = UDim2.new(alpha, 0, 0.5, 0)
			valueLabel.Text = fmt(value)
			bubble.Text = fmt(value)
			bubble.Position = UDim2.new(alpha, 0, 0, 27)
			tween(fill, 0.15, { BackgroundColor3 = Library.Theme.Primary })
			tween(knob, 0.15, { BackgroundColor3 = Library.Theme.Text })
		end

		local api = {}
		function api:Set(v, silent)
			v = math.clamp(tonumber(v) or min, min, max)
			value = v
			render()
			if cfg.Flag then w.Flags[cfg.Flag] = value end
			if cfg.Callback and not silent then task.spawn(cfg.Callback, value) end
		end
		function api:Get() return value end

		local function updateFromX(x)
			local rel = (x - trackFrame.AbsolutePosition.X) / math.max(trackFrame.AbsoluteSize.X, 1)
			rel = math.clamp(rel, 0, 1)
			local raw = min + rel * (max - min)
			if decimals == 0 then
				raw = math.floor(raw + 0.5)
			else
				local mult = 10 ^ decimals
				raw = math.floor(raw * mult + 0.5) / mult
			end
			api:Set(raw)
		end

		local function mouseOverRow()
			local m = guiMouse()
			local p, s = row.AbsolutePosition, row.AbsoluteSize
			return m.X >= p.X and m.X <= p.X + s.X and m.Y >= p.Y and m.Y <= p.Y + s.Y
		end

		-- drag via central manager; scrolling disabled while dragging
		track(row.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				if scrollParent then scrollParent.ScrollingEnabled = false end
				springGoal(knobScale, 0.2, { Scale = 1.35 })
				bubble.Visible = true
				updateFromX(UserInputService:GetMouseLocation().X)
				Drag.begin({
					move = function(x) updateFromX(x) end,
					stop = function()
						if scrollParent then scrollParent.ScrollingEnabled = true end
						tween(knobScale, 0.18, { Scale = 1 })
						bubble.Visible = mouseOverRow()
					end,
				})
			end
		end))

		track(row.MouseEnter:Connect(function()
			springGoal(knobScale, 0.2, { Scale = 1.15 })
			bubble.Visible = true
		end))
		track(row.MouseLeave:Connect(function()
			if not Drag.isActive() then
				tween(knobScale, 0.18, { Scale = 1 })
				bubble.Visible = false
			end
		end))

		onTheme(render)
		render()
		decorate(row, cfg, parent)
		if cfg.Flag then w.Flags[cfg.Flag] = value; w.Options[cfg.Flag] = api end
		return api
	end

