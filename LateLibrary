------------------------------------------------------------
-- Theme registry (multi-window)
------------------------------------------------------------
local openWindows = {}

function Library:SetTheme(patch)
	for k, v in pairs(patch or {}) do
		Library.Theme[k] = v
	end
	for _, win in ipairs(openWindows) do
		if win._applyTheme then win._applyTheme() end
	end
end

function Library:GetTheme()
	return Library.Theme
end

------------------------------------------------------------
-- Instance helpers
------------------------------------------------------------
local function create(className, props)
	local inst = Instance.new(className)
	for k, v in pairs(props or {}) do
		inst[k] = v
	end
	return inst
end

local function corner(parent, radius)
	return create("UICorner", { CornerRadius = radius or Library.Theme.Radius, Parent = parent })
end

local function stroke(parent, color, thickness, transparency)
	return create("UIStroke", {
		Color = color or Library.Theme.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

local function pad(parent, px)
	return create("UIPadding", {
		PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px),
		Parent = parent,
	})
end

local function vgradient(parent, topT, botT, c1, c2)
	return create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, math.clamp(topT, 0, 1)),
			NumberSequenceKeypoint.new(1, math.clamp(botT, 0, 1)),
		}),
		Color = ColorSequence.new(
			c1 or Color3.fromRGB(255, 255, 255),
			c2 or Color3.fromRGB(255, 255, 255)
		),
		Parent = parent,
	})
end

local function topHighlight(parent, transparency)
	local line = create("Frame", {
		Name = "TopHighlight",
		Size = UDim2.new(1, -2, 0, 1),
		Position = UDim2.fromOffset(1, 0),
		BackgroundColor3 = Library.Theme.Highlight,
		BackgroundTransparency = transparency or 0.86,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = parent,
	})
	return line
end

------------------------------------------------------------
-- Animation
------------------------------------------------------------
local function tween(inst, time, goal, style, dir)
	local t = TweenService:Create(
		inst,
		TweenInfo.new(time or 0.2, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		goal
	)
	t:Play()
	return t
end

local function springGoal(inst, time, goal)
	return tween(inst, time or 0.24, goal, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

------------------------------------------------------------
-- Mouse in GUI space
--   GetMouseLocation() liefert Koordinaten ohne GuiInset,
--   AbsolutePosition liegt um den Inset versetzt → hier korrigieren.
------------------------------------------------------------
local function guiInset()
	return GuiService:GetGuiInset()
end

local function guiMouse()
	local m = UserInputService:GetMouseLocation()
	local inset = guiInset()
	return Vector2.new(m.X - inset.X, m.Y - inset.Y)
end

------------------------------------------------------------
-- Central Drag Manager
--   one RenderStepped + one InputEnded for the whole library
------------------------------------------------------------
local dragTarget = nil
local dragConnected = false

local function ensureDrag()
	if dragConnected then return end
	dragConnected = true
	RunService.RenderStepped:Connect(function()
		if dragTarget and dragTarget.move then
			local m = UserInputService:GetMouseLocation()
			dragTarget.move(m.X, m.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			local t = dragTarget
			dragTarget = nil
			if t and t.stop then t.stop() end
		end
	end)
end

local Drag = {}
function Drag.begin(target)
	ensureDrag()
	dragTarget = target
end
function Drag.isActive()
	return dragTarget ~= nil
end

------------------------------------------------------------
-- GUI parent resolution
------------------------------------------------------------
local function resolveParent()
	if gethui then
		local ok, hui = pcall(gethui)
		if ok and hui then return hui end
	end
	if RunService:IsStudio() then
		return Players.LocalPlayer:WaitForChild("PlayerGui")
	end
	local ok, core = pcall(function() return game:GetService("CoreGui") end)
	if ok and core then return core end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

