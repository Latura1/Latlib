			Name = "Watermark",
			Default = (w._watermark ~= nil),
			Callback = function(v) w:SetWatermarkVisible(v) end,
		})
		behSec:Button({
			Name = "Reset Position",
			Callback = function() w:ResetPosition() end,
		})

		return tab
	end

