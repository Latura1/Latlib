	-- Slider ----------------------------------------------------
	function w:_Slider(parent, cfg)
		cfg = cfg or {}
		local min      = cfg.Min or 0
		local max      = cfg.Max or 100
		local decimals = cfg.Decimals or 0
		local suffix   = cfg.Suffix or ""
		local value    = cfg.Default or min

		local scrollParent = parent:FindFirstAncestorWhichIsA("ScrollingFrame")

		local row = create("Frame", {
			Size = UDim2.new(1, 0, 0, 42),
			BackgroundTransparency = 1,
			Active = true,
			Parent = parent,
		})
		local nameLabel = create("TextLabel", {
			Size = UDim2.new(1, -60, 0, 18),
			BackgroundTransparency = 1,
			Text = cfg.Name or "Slider",
			Font = Library.Theme.Font,
			TextSize = 13,
			TextColor3 = Library.Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		reg(nameLabel, "TextColor3", "Text")

		local valueLabel = create("TextLabel", {
			Size = UDim2.new(0, 60, 0, 18),
			Position = UDim2.new(1, -60, 0, 0),
			BackgroundTransparency = 1,
			Text = "",
			Font = Library.Theme.Font,
			TextSize = 13,
			TextColor3 = Library.Theme.TextSub,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = row,
		})
		reg(valueLabel, "TextColor3", "TextSub")

		local trackFrame = create("Frame", {
			Size = UDim2.new(1, 0, 0, 6),
			Position = UDim2.fromOffset(0, 28),
			BackgroundColor3 = Library.Theme.Bg4,
			BorderSizePixel = 0,
			Active = false,
			Parent = row,
		})
		corner(trackFrame, UDim.new(1, 0))

		local fill = create("Frame", {
			Size = UDim2.new(0, 0, 1, 0),
			BackgroundColor3 = Library.Theme.Primary,
			BorderSizePixel = 0,
			Parent = trackFrame,
		})
		corner(fill, UDim.new(1, 0))
		vgradient(fill, 0, 0, Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 210, 255))

		local knob = create("Frame", {
			Size = UDim2.fromOffset(14, 14),
			Position = UDim2.new(0, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Library.Theme.Text,
			BorderSizePixel = 0,
			Parent = trackFrame,
		})
		corner(knob, UDim.new(1, 0))

		local knobScale = create("UIScale", { Scale = 1, Parent = knob })

		-- value bubble on hover / drag
		local bubble = create("TextLabel", {
			Size = UDim2.fromOffset(46, 18),
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0, 0, 0, 24),
			BackgroundColor3 = Library.Theme.Primary,
			Text = "",
			Font = Library.Theme.FontBold,
			TextSize = 11,
			TextColor3 = Color3.fromRGB(255, 255, 255),
			Visible = false,
			ZIndex = 6,
			Parent = row,
		})
		corner(bubble, UDim.new(0, 5))
		reg(bubble, "BackgroundColor3", "Primary")

		local function fmt(v)
			return string.format("%." .. decimals .. "f", v) .. suffix
		end
		local function render()
			local alpha = (max > min) and (value - min) / (max - min) or 0
			fill.Size     = UDim2.new(alpha, 0, 1, 0)
			knob.Position = UDim2.new(alpha, 0, 0.5, 0)
			valueLabel.Text = fmt(value)
			bubble.Text = fmt(value)
			bubble.Position = UDim2.new(alpha, 0, 0, 27)
			tween(fill, 0.15, { BackgroundColor3 = Library.Theme.Primary })
			tween(knob, 0.15, { BackgroundColor3 = Library.Theme.Text })
		end

		local api = {}
		function api:Set(v, silent)
			v = math.clamp(tonumber(v) or min, min, max)
			value = v
			render()
			if cfg.Flag then w.Flags[cfg.Flag] = value end
			if cfg.Callback and not silent then task.spawn(cfg.Callback, value) end
		end
		function api:Get() return value end

		local function updateFromX(x)
			local rel = (x - trackFrame.AbsolutePosition.X) / math.max(trackFrame.AbsoluteSize.X, 1)
			rel = math.clamp(rel, 0, 1)
			local raw = min + rel * (max - min)
			if decimals == 0 then
				raw = math.floor(raw + 0.5)
			else
				local mult = 10 ^ decimals
				raw = math.floor(raw * mult + 0.5) / mult
			end
			api:Set(raw)
		end

		local function mouseOverRow()
			local m = UserInputService:GetMouseLocation()
			local p, s = row.AbsolutePosition, row.AbsoluteSize
			return m.X >= p.X and m.X <= p.X + s.X and m.Y >= p.Y and m.Y <= p.Y + s.Y
		end

		-- drag via central manager; scrolling disabled while dragging
		track(row.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				if scrollParent then scrollParent.ScrollingEnabled = false end
				springGoal(knobScale, 0.2, { Scale = 1.35 })
				bubble.Visible = true
				updateFromX(UserInputService:GetMouseLocation().X)
				Drag.begin({
					move = function(x) updateFromX(x) end,
					stop = function()
						if scrollParent then scrollParent.ScrollingEnabled = true end
						tween(knobScale, 0.18, { Scale = 1 })
						bubble.Visible = mouseOverRow()
					end,
				})
			end
		end))

		track(row.MouseEnter:Connect(function()
			springGoal(knobScale, 0.2, { Scale = 1.15 })
			bubble.Visible = true
		end))
		track(row.MouseLeave:Connect(function()
			if not Drag.isActive() then
				tween(knobScale, 0.18, { Scale = 1 })
				bubble.Visible = false
			end
		end))

		onTheme(render)
		render()
		if cfg.Flag then w.Flags[cfg.Flag] = value; w.Options[cfg.Flag] = api end
		return api
	end

	-- Dropdown --------------------------------------------------
	function w:_Dropdown(parent, cfg)
		cfg = cfg or {}
		local multi = cfg.Multi and true or false
		local options = cfg.Options or {}
