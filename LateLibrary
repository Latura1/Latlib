function Library.new(config)
	config = config or {}
	local w = { Flags = {}, Tabs = {}, Options = {} }
	local fullSize = config.Size or UDim2.fromOffset(560, 380)

	local connections = {}
	local function track(conn)
		connections[#connections + 1] = conn
		return conn
	end

	local themeBinds = {}
	local themeRerenders = {}
	local function reg(inst, prop, key)
		themeBinds[#themeBinds + 1] = { inst = inst, prop = prop, key = key }
		if Library.Theme[key] ~= nil then
			pcall(function() inst[prop] = Library.Theme[key] end)
		end
		return inst
	end
	local function onTheme(fn)
		themeRerenders[#themeRerenders + 1] = fn
		return fn
	end
	local function glassGradient(parent, key, c1, c2)
		local g = vgradient(
			parent,
			Library.Theme[key] - 0.03,
			Library.Theme[key] + 0.08,
			c1 or Color3.fromRGB(255, 255, 255),
			c2 or Color3.fromRGB(210, 216, 235)
		)
		onTheme(function()
			g.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, math.clamp(Library.Theme[key] - 0.03, 0, 1)),
				NumberSequenceKeypoint.new(1, math.clamp(Library.Theme[key] + 0.08, 0, 1)),
			})
		end)
		return g
	end
	local function applyTheme()
		for _, b in ipairs(themeBinds) do
			pcall(function() b.inst[b.prop] = Library.Theme[b.key] end)
		end
		for _, fn in ipairs(themeRerenders) do
			pcall(fn)
		end
	end
	w._applyTheme = applyTheme

	-- Search registry -------------------------------------------
	local searchable = {}
	local sectionFrames = {}
	local holderSection = {}   -- holder-Instance -> section-Frame (keine Custom-Felder auf Instances!)
	local function registerSearchable(row, name, parent)
		if not name or name == "" then return end
		searchable[#searchable + 1] = {
			name = string.lower(name),
			row = row,
			section = parent and holderSection[parent],
		}
	end

	function w:ApplySearch(query)
		query = string.lower(query or "")
		local sectionHas = {}
		for _, e in ipairs(searchable) do
			local match = query == "" or string.find(e.name, query, 1, true) ~= nil
			e.row.Visible = match
			if match and e.section then sectionHas[e.section] = true end
		end
		for _, sf in ipairs(sectionFrames) do
			sf.Visible = (query == "") or (sectionHas[sf] == true)
		end
	end

