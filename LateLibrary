		r = w:_Slider(container, { Name = "R", Min = 0, Max = 255, Default = math.floor(default.R * 255 + 0.5), Callback = function() api:Changed() end })
		g = w:_Slider(container, { Name = "G", Min = 0, Max = 255, Default = math.floor(default.G * 255 + 0.5), Callback = function() api:Changed() end })
		b = w:_Slider(container, { Name = "B", Min = 0, Max = 255, Default = math.floor(default.B * 255 + 0.5), Callback = function() api:Changed() end })

		function api:Get()
			return Color3.fromRGB(r:Get(), g:Get(), b:Get())
		end
		function api:Changed(silent)
			preview.BackgroundColor3 = api:Get()
			if cfg.Flag then w.Flags[cfg.Flag] = api:Get() end
			if cfg.Callback and not silent then task.spawn(cfg.Callback, api:Get()) end
		end
		function api:Set(color, silent)
			r:Set(math.floor(color.R * 255 + 0.5), true)
			g:Set(math.floor(color.G * 255 + 0.5), true)
			b:Set(math.floor(color.B * 255 + 0.5), true)
			api:Changed(silent)
		end

		api:Changed(true)
		if cfg.Flag then w.Flags[cfg.Flag] = api:Get(); w.Options[cfg.Flag] = api end
		return api
	end

