		local api = {}
		local scrollParent = parent:FindFirstAncestorWhichIsA("ScrollingFrame")

		local function updateVisuals()
			local color = Color3.fromHSV(h, s, v)
			field.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
			cursor.Position = UDim2.fromScale(s, 1 - v)
			hueKnob.Position = UDim2.new(h, 0, 0.5, 0)
			preview.BackgroundColor3 = color
			hexBox.Text = "#" .. color:ToHex()
		end

		local function emit(silent)
			updateVisuals()
			local color = Color3.fromHSV(h, s, v)
			if cfg.Flag then w.Flags[cfg.Flag] = color end
			if cfg.Callback and not silent then task.spawn(cfg.Callback, color) end
		end

		track(field.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				if scrollParent then scrollParent.ScrollingEnabled = false end
				local function apply(rawX, rawY)
					local inset = guiInset()
					local x, y = rawX - inset.X, rawY - inset.Y
					local p, sz = field.AbsolutePosition, field.AbsoluteSize
					s = math.clamp((x - p.X) / math.max(sz.X, 1), 0, 1)
					v = 1 - math.clamp((y - p.Y) / math.max(sz.Y, 1), 0, 1)
					emit()
				end
				local m = UserInputService:GetMouseLocation()
				apply(m.X, m.Y)
				Drag.begin({
					move = function(x, y) apply(x, y) end,
					stop = function() if scrollParent then scrollParent.ScrollingEnabled = true end end,
				})
			end
		end))

		track(hueBar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				if scrollParent then scrollParent.ScrollingEnabled = false end
				local function apply(x)
					local p, sz = hueBar.AbsolutePosition, hueBar.AbsoluteSize
					h = math.clamp((x - p.X) / math.max(sz.X, 1), 0, 1)
					emit()
				end
				local m = UserInputService:GetMouseLocation()
				apply(m.X)
				Drag.begin({
					move = function(x) apply(x) end,
					stop = function() if scrollParent then scrollParent.ScrollingEnabled = true end end,
				})
			end
		end))

		track(hexBox.FocusLost:Connect(function()
			local text = hexBox.Text:gsub("#", "")
			local ok, color = pcall(Color3.fromHex, text)
			if ok then
				h, s, v = color:ToHSV()
				emit()
			else
				updateVisuals()
			end
		end))

		for _, preset in ipairs(cfg.Presets or {
			Color3.fromRGB(255, 80, 80),
			Color3.fromRGB(255, 170, 60),
			Color3.fromRGB(255, 235, 80),
			Color3.fromRGB(90, 220, 120),
			Color3.fromRGB(90, 160, 255),
			Color3.fromRGB(170, 110, 255),
			Color3.fromRGB(255, 255, 255),
		}) do
			local sw = create("TextButton", {
				Size = UDim2.fromOffset(22, 22),
				BackgroundColor3 = preset,
				Text = "",
				AutoButtonColor = false,
				Parent = presetRow,
			})
			corner(sw, Library.Theme.RadiusSm)
			stroke(sw, Library.Theme.Stroke, 1, 0.4)
			track(sw.MouseButton1Click:Connect(function()
				h, s, v = preset:ToHSV()
				emit()
			end))
		end

		function api:Get() return Color3.fromHSV(h, s, v) end
		function api:Set(color, silent)
			h, s, v = color:ToHSV()
			emit(silent)
		end

		updateVisuals()
		decorate(container, cfg, parent)
		if cfg.Flag then w.Flags[cfg.Flag] = api:Get(); w.Options[cfg.Flag] = api end
		return api
	end

	-- RangeSlider -----------------------------------------------
	function w:_RangeSlider(parent, cfg)
		cfg = cfg or {}
		local min      = cfg.Min or 0
		local max      = cfg.Max or 100
		local decimals = cfg.Decimals or 0
		local lo, hi = min, max
		if type(cfg.Default) == "table" then
			lo = math.clamp(cfg.Default[1] or min, min, max)
			hi = math.clamp(cfg.Default[2] or max, min, max)
		end
		local scrollParent = parent:FindFirstAncestorWhichIsA("ScrollingFrame")

		local row = create("Frame", {
			Size = UDim2.new(1, 0, 0, 42),
			BackgroundTransparency = 1,
			Active = true,
			Parent = parent,
		})
		local nameLabel = create("TextLabel", {
			Size = UDim2.new(1, -70, 0, 18),
			BackgroundTransparency = 1,
			Text = cfg.Name or "Range",
			Font = Library.Theme.Font,
			TextSize = 13,
			TextColor3 = Library.Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		reg(nameLabel, "TextColor3", "Text")
		local valueLabel = create("TextLabel", {
			Size = UDim2.new(0, 70, 0, 18),
			Position = UDim2.new(1, -70, 0, 0),
			BackgroundTransparency = 1,
			Text = "",
			Font = Library.Theme.Font,
			TextSize = 12,
			TextColor3 = Library.Theme.TextSub,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = row,
		})
		reg(valueLabel, "TextColor3", "TextSub")

		local trackFrame = create("Frame", {
			Size = UDim2.new(1, 0, 0, 6),
			Position = UDim2.fromOffset(0, 28),
			BackgroundColor3 = Library.Theme.Bg4,
			BorderSizePixel = 0,
			Active = false,
			Parent = row,
		})
		corner(trackFrame, UDim.new(1, 0))

		local fill = create("Frame", {
			Size = UDim2.new(0, 0, 1, 0),
			BackgroundColor3 = Library.Theme.Primary,
			BorderSizePixel = 0,
			Parent = trackFrame,
		})
		corner(fill, UDim.new(1, 0))
		vgradient(fill, 0, 0, Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 210, 255))

		local knobLo = create("Frame", {
			Size = UDim2.fromOffset(14, 14),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			BackgroundColor3 = Library.Theme.Text,
			BorderSizePixel = 0,
			Parent = trackFrame,
		})
		corner(knobLo, UDim.new(1, 0))
		local knobHi = create("Frame", {
			Size = UDim2.fromOffset(14, 14),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			BackgroundColor3 = Library.Theme.Text,
			BorderSizePixel = 0,
			Parent = trackFrame,
		})
		corner(knobHi, UDim.new(1, 0))

		local function fmt(v)
			return string.format("%." .. decimals .. "f", v)
		end
		local function alphaOf(v)
			return (max > min) and (v - min) / (max - min) or 0
		end
		local function render()
			local aLo, aHi = alphaOf(lo), alphaOf(hi)
			fill.Position = UDim2.new(aLo, 0, 0, 0)
			fill.Size = UDim2.new(aHi - aLo, 0, 1, 0)
			knobLo.Position = UDim2.new(aLo, 0, 0.5, 0)
			knobHi.Position = UDim2.new(aHi, 0, 0.5, 0)
			valueLabel.Text = fmt(lo) .. " - " .. fmt(hi)
			tween(fill, 0.15, { BackgroundColor3 = Library.Theme.Primary })
			tween(knobLo, 0.15, { BackgroundColor3 = Library.Theme.Text })
			tween(knobHi, 0.15, { BackgroundColor3 = Library.Theme.Text })
		end

		local api = {}
		function api:Get() return { lo, hi } end
		function api:Set(value, silent)
			if type(value) == "table" then
				lo = math.clamp(tonumber(value[1]) or min, min, max)
				hi = math.clamp(tonumber(value[2]) or max, min, max)
			end
			if lo > hi then lo, hi = hi, lo end
			render()
			if cfg.Flag then w.Flags[cfg.Flag] = { lo, hi } end
			if cfg.Callback and not silent then task.spawn(cfg.Callback, { lo, hi }) end
		end

		local function valFromX(x)
			local rel = math.clamp((x - trackFrame.AbsolutePosition.X) / math.max(trackFrame.AbsoluteSize.X, 1), 0, 1)
			local raw = min + rel * (max - min)
			if decimals == 0 then
				raw = math.floor(raw + 0.5)
			else
				local mult = 10 ^ decimals
				raw = math.floor(raw * mult + 0.5) / mult
			end
			return raw
		end

		track(row.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				if scrollParent then scrollParent.ScrollingEnabled = false end
				local inset = guiInset()
				local mx = UserInputService:GetMouseLocation().X - inset.X
				local target = valFromX(mx)
				local which = (math.abs(target - lo) <= math.abs(target - hi)) and "lo" or "hi"
				local function apply(x)
					local v = valFromX(x)
					if which == "lo" then
						lo = math.min(v, hi)
					else
						hi = math.max(v, lo)
					end
					render()
					if cfg.Flag then w.Flags[cfg.Flag] = { lo, hi } end
					if cfg.Callback then task.spawn(cfg.Callback, { lo, hi }) end
				end
				apply(mx)
				Drag.begin({
					move = function(x) apply(x - inset.X) end,
					stop = function() if scrollParent then scrollParent.ScrollingEnabled = true end end,
				})
			end
		end))

		onTheme(render)
		render()
		decorate(row, cfg, parent)
		if cfg.Flag then w.Flags[cfg.Flag] = { lo, hi }; w.Options[cfg.Flag] = api end
		return api
	end

