	-- Notifications ---------------------------------------------
	local notifyGui, notifyList, notifyCount = nil, nil, 0
	local activeNotifies = {}

	local function ensureNotify()
		if notifyGui and notifyGui.Parent then return end
		notifyGui = create("ScreenGui", {
			Name = "LunarNotify",
			ResetOnSpawn = false,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
			IgnoreGuiInset = true,
			DisplayOrder = 200,
			Parent = resolveParent(),
		})
		notifyList = create("Frame", {
			Name = "List",
			Size = UDim2.new(0, Library.NotifyWidth, 1, 0),
			Position = UDim2.new(1, -16, 0, 16),
			AnchorPoint = Vector2.new(1, 0),
			BackgroundTransparency = 1,
			Parent = notifyGui,
		})
		create("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			Parent = notifyList,
		})
	end

	function w:Notify(cfg)
		cfg = cfg or {}
		ensureNotify()
		notifyCount = notifyCount + 1

		local WIDTH = Library.NotifyWidth
		local PADDING = 12
		local innerW = WIDTH - PADDING * 2
		local titleH = 16
		local bodyText = cfg.Text or ""
		local bodyH = 0
		if #bodyText > 0 then
			local bounds = TextService:GetTextSize(bodyText, 12, Library.Theme.Font, Vector2.new(innerW, 100000))
			bodyH = math.ceil(bounds.Y)
		end
		local gap = (bodyH > 0) and 3 or 0
		local actions = cfg.Actions
		local hasActions = type(actions) == "table" and #actions > 0
		local progressH = cfg.Progress and 14 or 0
		local actionsH = hasActions and 30 or 0
		local extraGap = (progressH > 0 or actionsH > 0) and 6 or 0
		local totalH = PADDING + titleH + gap + bodyH + extraGap + progressH + actionsH + PADDING

		local card = create("CanvasGroup", {
			Size = UDim2.fromOffset(WIDTH, totalH),
			BackgroundColor3 = Library.Theme.Bg2,
			BackgroundTransparency = Library.Theme.PanelOpacity,
			BorderSizePixel = 0,
			GroupTransparency = 1,
			LayoutOrder = -notifyCount,
			Parent = notifyList,
		})
		corner(card, Library.Theme.Radius)
		stroke(card, Library.Theme.Stroke, 1, 0.3)
		glassGradient(card, "PanelOpacity", Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 206, 230))
		pad(card, PADDING)

		local click = create("TextButton", {
			Size = UDim2.new(1, PADDING * 2, 1, PADDING * 2),
			Position = UDim2.fromOffset(-PADDING, -PADDING),
			BackgroundTransparency = 1,
			Text = "",
			Parent = card,
		})

		local titleRow = create("Frame", {
			Size = UDim2.new(1, 0, 0, titleH),
			BackgroundTransparency = 1,
			Parent = card,
		})
		local titleLabel = create("TextLabel", {
			Size = UDim2.new(1, -20, 1, 0),
			BackgroundTransparency = 1,
			Text = cfg.Title or "Notify",
			Font = Library.Theme.FontBold,
			TextSize = 13,
			TextColor3 = cfg.Color or Library.Theme.Primary,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = titleRow,
		})
		local closeBtn = create("TextButton", {
			Size = UDim2.fromOffset(16, 16),
			Position = UDim2.new(1, -16, 0, 0),
			BackgroundTransparency = 1,
			Text = "x",
			Font = Library.Theme.FontBold,
			TextSize = 12,
			TextColor3 = Library.Theme.TextMuted,
			AutoButtonColor = false,
			Parent = titleRow,
		})

		if bodyH > 0 then
			local bodyLabel = create("TextLabel", {
				Size = UDim2.fromOffset(innerW, bodyH),
				Position = UDim2.fromOffset(0, titleH + gap),
				BackgroundTransparency = 1,
				Text = bodyText,
				Font = Library.Theme.Font,
				TextSize = 12,
				TextColor3 = Library.Theme.TextSub,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
				Parent = card,
			})
			reg(bodyLabel, "TextColor3", "TextSub")
		end

		-- fix layout: title label width
		titleLabel.Size = UDim2.new(1, -20, 1, 0)

		tween(card, 0.2, { GroupTransparency = 0 })

		local dismissed = false
		local entry
		local function dismiss()
			if dismissed then return end
			dismissed = true
			for i, e in ipairs(activeNotifies) do
				if e == entry then table.remove(activeNotifies, i) break end
			end
			local t = tween(card, 0.2, { GroupTransparency = 1 })
			track(t.Completed:Connect(function() card:Destroy() end))
		end
		entry = { dismiss = dismiss }

		local cursorY = titleH + gap + bodyH + extraGap
		if progressH > 0 then
			local pbar = create("Frame", {
				Size = UDim2.fromOffset(innerW, 6),
				Position = UDim2.fromOffset(0, cursorY),
				BackgroundColor3 = Library.Theme.Bg4,
				BorderSizePixel = 0,
				Parent = card,
			})
			corner(pbar, UDim.new(1, 0))
			local pfill = create("Frame", {
				Size = UDim2.new(math.clamp(cfg.Progress, 0, 1), 0, 1, 0),
				BackgroundColor3 = cfg.Color or Library.Theme.Primary,
				BorderSizePixel = 0,
				Parent = pbar,
			})
			corner(pfill, UDim.new(1, 0))
			cursorY = cursorY + 14
		end
		if hasActions then
			local actionRow = create("Frame", {
				Size = UDim2.new(1, 0, 0, 24),
				Position = UDim2.fromOffset(0, cursorY),
				BackgroundTransparency = 1,
				Parent = card,
			})
			create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 6),
				Parent = actionRow,
			})
			for _, action in ipairs(actions) do
				local b = create("TextButton", {
					Size = UDim2.fromOffset(0, 24),
					AutomaticSize = Enum.AutomaticSize.X,
					BackgroundColor3 = action.Color or Library.Theme.Primary,
					BackgroundTransparency = 0.1,
					Text = "  " .. (action.Name or "OK") .. "  ",
					Font = Library.Theme.Font,
					TextSize = 12,
					TextColor3 = Color3.fromRGB(255, 255, 255),
					AutoButtonColor = false,
					Parent = actionRow,
				})
				corner(b, UDim.new(0, 5))
				track(b.MouseButton1Click:Connect(function()
					if action.Callback then task.spawn(action.Callback) end
					dismiss()
				end))
			end
		end

		track(closeBtn.MouseButton1Click:Connect(dismiss))
		track(click.MouseButton1Click:Connect(dismiss))

		table.insert(activeNotifies, entry)
		while #activeNotifies > Library.MaxNotifies do
			local oldest = table.remove(activeNotifies, 1)
			if oldest and oldest.dismiss then oldest.dismiss() end
		end

		local duration = cfg.Duration or 4
		if duration > 0 then
			task.delay(duration, dismiss)
		end
		return dismiss
	end

	-- Config Save / Load ----------------------------------------
	local function fsAvailable()
		return type(writefile) == "function"
			and type(readfile) == "function"
			and type(isfile) == "function"
	end

	function w:GetFlags()
		local copy = {}
		for k, v in pairs(w.Flags) do
			if typeof(v) == "Color3" then
				copy[k] = { __color = true, v = v:ToHex() }
			else
				copy[k] = v
			end
		end
		return copy
	end

	function w:ListConfigs()
		local names = {}
		if fsAvailable() and type(listfiles) == "function" and type(isfolder) == "function" then
			pcall(function()
				if isfolder(Library.ConfigFolder) then
					for _, path in ipairs(listfiles(Library.ConfigFolder)) do
						local name = tostring(path):match("([^/\\]+)%.json$")
						if name then table.insert(names, name) end
					end
				end
			end)
		elseif w._saved then
			for name in pairs(w._saved) do table.insert(names, name) end
		end
		table.sort(names)
		return names
	end

	local function configPath(name)
		return Library.ConfigFolder .. "/" .. name .. ".json"
	end

	local function writeRaw(name, data)
		if fsAvailable() then
			if type(isfolder) == "function" and type(makefolder) == "function" then
				if not isfolder(Library.ConfigFolder) then makefolder(Library.ConfigFolder) end
			end
			writefile(configPath(name), data)
		else
			w._saved = w._saved or {}
			w._saved[name] = data
		end
	end

	local function readRaw(name)
		if fsAvailable() then
			local path = configPath(name)
			if not isfile(path) then return nil end
			return readfile(path)
		end
		return w._saved and w._saved[name]
	end

	local function deleteRaw(name)
		if fsAvailable() then
			local path = configPath(name)
			if isfile(path) then delfile(path) end
		elseif w._saved then
			w._saved[name] = nil
		end
	end

	function w:_applyFlags(decoded)
		for flag, value in pairs(decoded) do
			if type(value) == "table" and value.__color then
				value = Color3.fromHex(value.v)
			end
			w.Flags[flag] = value
			local opt = w.Options[flag]
			if opt and opt.Set then
				pcall(function() opt:Set(value, true) end)
			end
		end
	end

	function w:SaveConfig(name, silent)
		name = name or "default"
		writeRaw(name, HttpService:JSONEncode(w:GetFlags()))
		if not silent then
			w:Notify({ Title = "Config", Text = "Saved: " .. name })
		end
	end

	function w:LoadConfig(name, silent)
		name = name or "default"
		local data = readRaw(name)
		if not data then
			w:Notify({ Title = "Config", Text = "Not found: " .. name, Color = Library.Theme.Danger })
			return false
		end
		local ok, decoded = pcall(function() return HttpService:JSONDecode(data) end)
		if not ok or type(decoded) ~= "table" then
			w:Notify({ Title = "Config", Text = "Parse error", Color = Library.Theme.Danger })
			return false
		end
		if decoded.flags then decoded = decoded.flags end
		w:_applyFlags(decoded)
		if not silent then
			w:Notify({ Title = "Config", Text = "Loaded: " .. name })
		end
		return true
	end

	function w:DeleteConfig(name)
		name = name or "default"
		deleteRaw(name)
		w:Notify({ Title = "Config", Text = "Deleted: " .. name })
	end

	function w:RenameConfig(oldName, newName)
		if not oldName or not newName or oldName == "" or newName == "" then return false end
		local data = readRaw(oldName)
		if not data then
			w:Notify({ Title = "Config", Text = "Not found: " .. oldName, Color = Library.Theme.Danger })
			return false
		end
		writeRaw(newName, data)
		deleteRaw(oldName)
		w:Notify({ Title = "Config", Text = "Renamed: " .. oldName .. " -> " .. newName })
		return true
	end

	function w:DuplicateConfig(oldName, newName)
		if not oldName or not newName or newName == "" then return false end
		local data = readRaw(oldName)
		if not data then
			w:Notify({ Title = "Config", Text = "Not found: " .. oldName, Color = Library.Theme.Danger })
			return false
		end
		writeRaw(newName, data)
		w:Notify({ Title = "Config", Text = "Duplicated -> " .. newName })
		return true
	end

	function w:ExportConfig(name)
		name = name or "default"
		local data = readRaw(name)
		if not data then
			w:Notify({ Title = "Config", Text = "Not found: " .. name, Color = Library.Theme.Danger })
			return nil
		end
		local ok, decoded = pcall(function() return HttpService:JSONDecode(data) end)
		local payload = HttpService:JSONEncode({
			__lunar = 2,
			name = name,
			flags = ok and decoded or {},
		})
		if type(setclipboard) == "function" then
			pcall(setclipboard, payload)
			w:Notify({ Title = "Config", Text = "Export -> Clipboard" })
		else
			w:Notify({ Title = "Config", Text = "Clipboard nicht verfuegbar", Color = Library.Theme.Danger })
		end
		return payload
	end

	function w:ImportConfig(data, saveAs)
		if not data or data == "" then
			if type(getclipboard) == "function" then
				local ok, clip = pcall(getclipboard)
				if ok then data = clip end
			end
		end
		if not data or data == "" then
			w:Notify({ Title = "Config", Text = "Clipboard leer", Color = Library.Theme.Danger })
			return false
		end
		local ok, decoded = pcall(function() return HttpService:JSONDecode(data) end)
		if not ok or type(decoded) ~= "table" then
			w:Notify({ Title = "Config", Text = "Ungueltige Config", Color = Library.Theme.Danger })
			return false
		end
		local flags = decoded.flags or decoded
		w:_applyFlags(flags)
		if saveAs and saveAs ~= "" then
			writeRaw(saveAs, HttpService:JSONEncode(flags))
		end
		w:Notify({ Title = "Config", Text = "Imported" .. (saveAs and saveAs ~= "" and (" -> " .. saveAs) or "") })
		return true
	end

	function w:SetAutoSave(enabled, name)
		w._autoSaveName = name or w._autoSaveName or "autosave"
		if enabled then
			if w._autoSave then return end
			w._autoSave = true
			local last = HttpService:JSONEncode(w:GetFlags())
			task.spawn(function()
				while w._autoSave do
					task.wait(2)
					local now = HttpService:JSONEncode(w:GetFlags())
					if now ~= last then
						last = now
						writeRaw(w._autoSaveName, now)
					end
				end
			end)
			w:Notify({ Title = "Config", Text = "Auto-Save an: " .. w._autoSaveName })
		else
			w._autoSave = false
			w:Notify({ Title = "Config", Text = "Auto-Save aus" })
		end
	end

	function w:IsAutoSave()
		return w._autoSave == true
	end

	-- Config manager (Dropdown + Save/Load/Delete/Refresh) -------
	function w:_ConfigManager(section, cfg)
		cfg = cfg or {}
		local dd = section:Dropdown({
			Name = cfg.Name or "Saved Configs",
			Options = w:ListConfigs(),
			Placeholder = (#w:ListConfigs() > 0) and "Select..." or "No configs found",
		})
		local nameBox = section:TextBox({
			Name = "Name (neu / Ziel)",
			Default = cfg.DefaultName or "",
			Placeholder = "config name...",
		})

		local function refresh()
			dd:SetOptions(w:ListConfigs(), false)
		end

		section:Button({
			Name = "Save",
			Callback = function()
				local n = nameBox:Get()
				if not n or n == "" then n = dd:Get() end
				if not n or n == "" then n = "default" end
				w:SaveConfig(n)
				refresh()
			end,
		})
		section:Button({
			Name = "Load selected",
			Callback = function()
				local n = dd:Get()
				if not n then
					w:Notify({ Title = "Config", Text = "Keine Config ausgewaehlt", Color = Library.Theme.Danger })
					return
				end
				w:LoadConfig(n)
			end,
		})
		section:Button({
			Name = "Delete selected",
			Callback = function()
				local n = dd:Get()
				if not n then return end
				w:DeleteConfig(n)
				refresh()
			end,
		})
		section:Button({
			Name = "Rename selected -> Name",
			Callback = function()
				local old = dd:Get()
				local new = nameBox:Get()
				if old and new and new ~= "" then
					w:RenameConfig(old, new)
					refresh()
				end
			end,
		})
		section:Button({
			Name = "Duplicate selected -> Name",
			Callback = function()
				local old = dd:Get()
				local new = nameBox:Get()
				if old and new and new ~= "" then
					w:DuplicateConfig(old, new)
					refresh()
				end
			end,
		})
		section:Button({
			Name = "Export selected (Clipboard)",
			Callback = function()
				local n = dd:Get()
				if n then w:ExportConfig(n) end
			end,
		})
		section:Button({
			Name = "Import (Clipboard)",
			Callback = function()
				w:ImportConfig(nil, nameBox:Get())
				refresh()
			end,
		})
		section:Toggle({
			Name = "Auto-Save",
			Default = w:IsAutoSave(),
			Callback = function(v)
				w:SetAutoSave(v, nameBox:Get())
			end,
		})
		section:Button({
			Name = "Refresh list",
			Callback = refresh,
		})

		return { Dropdown = dd, NameBox = nameBox, Refresh = refresh }
	end

