			TextSize = 13,
			TextColor3 = Library.Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = header,
		})
		reg(title, "TextColor3", "Text")

		local arrow = create("TextLabel", {
			Size = UDim2.fromOffset(20, 20),
			Position = UDim2.new(1, -26, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Text = "v",
			Font = Library.Theme.FontBold,
			TextSize = 12,
			TextColor3 = Library.Theme.TextSub,
			Parent = header,
		})
		reg(arrow, "TextColor3", "TextSub")

		local list = create("ScrollingFrame", {
			Size = UDim2.new(1, 0, 0, 0),
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = Library.Theme.Bg4,
			BackgroundColor3 = Library.Theme.Bg1,
			BorderSizePixel = 0,
			Visible = false,
			ClipsDescendants = true,
			Parent = container,
		})
		corner(list, Library.Theme.RadiusSm)
		stroke(list, Library.Theme.Stroke, 1, 0.3)
		create("UIListLayout", { Padding = UDim.new(0, 2), Parent = list })
		pad(list, 4)

		local searchBox = create("TextBox", {
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundColor3 = Library.Theme.Bg2,
			BackgroundTransparency = 0.1,
			Text = "",
			PlaceholderText = "Search...",
			PlaceholderColor3 = Library.Theme.TextMuted,
			Font = Library.Theme.Font,
			TextSize = 12,
			TextColor3 = Library.Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			ClearTextOnFocus = false,
			LayoutOrder = -1,
			Parent = list,
		})
		corner(searchBox, UDim.new(0, 4))
		create("UIPadding", {
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
			Parent = searchBox,
		})

		local api = {}
		local openList, closeList

		local function currentDisplay()
			if multi then
				local parts = {}
				for _, v in ipairs(options) do
					if selected[v] then table.insert(parts, tostring(v)) end
				end
				return (#parts > 0) and table.concat(parts, ", ") or (cfg.Placeholder or "Select...")
			end
			return (selected.value ~= nil) and tostring(selected.value) or (cfg.Placeholder or "Select...")
		end

		local function refresh()
			title.Text = currentDisplay()
			if cfg.Flag then w.Flags[cfg.Flag] = api:Get() end
		end

		local function clearOptions()
			for _, ob in ipairs(optionButtons) do ob:Destroy() end
			optionButtons = {}
		end

		local function listHeight()
			return math.min(28 + #optionButtons * 28 + 8, 190)
		end

		local function buildOptions()
			clearOptions()
			local query = string.lower(searchText)
			local idx = 0
			for _, opt in ipairs(options) do
				local label = tostring(opt)
				if query == "" or string.find(string.lower(label), query, 1, true) then
					idx = idx + 1
					local ob = create("TextButton", {
						Size = UDim2.new(1, 0, 0, 26),
						BackgroundColor3 = Library.Theme.Bg3,
						BackgroundTransparency = 1,
						Text = "   " .. label,
						Font = Library.Theme.Font,
						TextSize = 13,
						TextColor3 = Library.Theme.Text,
						TextXAlignment = Enum.TextXAlignment.Left,
						AutoButtonColor = false,
						LayoutOrder = idx,
						Parent = list,
					})
					corner(ob, UDim.new(0, 4))
					track(ob.MouseEnter:Connect(function() tween(ob, 0.1, { BackgroundTransparency = 0.15 }) end))
					track(ob.MouseLeave:Connect(function() tween(ob, 0.1, { BackgroundTransparency = 1 }) end))
					track(ob.MouseButton1Click:Connect(function()
						if multi then
							selected[opt] = not selected[opt]
						else
							selected.value = opt
							closeList()
						end
						refresh()
						if cfg.Callback then task.spawn(cfg.Callback, api:Get()) end
					end))
					table.insert(optionButtons, ob)
				end
			end
		end

		function openList()
			searchText = ""
			searchBox.Text = ""
			buildOptions()
			list.Visible = true
			list.Size = UDim2.new(1, 0, 0, 0)
			tween(list, 0.2, { Size = UDim2.new(1, 0, 0, listHeight()) })
			tween(arrow, 0.2, { Rotation = 180 })
		end

		function closeList()
			tween(list, 0.16, { Size = UDim2.new(1, 0, 0, 0) })
			tween(arrow, 0.2, { Rotation = 0 })
			task.delay(0.18, function()
				if list.Size.Y.Offset <= 1 then list.Visible = false end
			end)
		end

		function api:Get()
			if multi then
				local t = {}
				for _, v in ipairs(options) do
					if selected[v] then table.insert(t, v) end
				end
				return t
			end
			return selected.value
		end

		function api:Set(value, silent)
			if multi then
				selected = {}
				if type(value) == "table" then
					for _, v in ipairs(value) do selected[v] = true end
				end
			else
				selected = { value = value }
			end
			refresh()
			if cfg.Callback and not silent then task.spawn(cfg.Callback, api:Get()) end
		end

		function api:SetOptions(newOptions, keepSelection)
			options = newOptions or {}
			if not keepSelection then
				selected = multi and {} or { value = nil }
			end
			buildOptions()
			if list.Visible then
				list.Size = UDim2.new(1, 0, 0, listHeight())
			end
			refresh()
		end

		track(searchBox:GetPropertyChangedSignal("Text"):Connect(function()
			searchText = searchBox.Text
			buildOptions()
			if list.Visible then
				list.Size = UDim2.new(1, 0, 0, listHeight())
			end
		end))

		buildOptions()
		refresh()

		track(header.MouseButton1Click:Connect(function()
			if list.Visible then
				closeList()
			else
				openList()
			end
		end))

		if cfg.Flag then w.Flags[cfg.Flag] = api:Get(); w.Options[cfg.Flag] = api end
		return api
	end

