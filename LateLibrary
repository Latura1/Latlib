			local startMouse = UserInputService:GetMouseLocation()
			local startPos = w.Main.Position
			local sc = w.Scale.Scale
			Drag.begin({
				move = function(x, y)
					local dx = (x - startMouse.X) / sc
					local dy = (y - startMouse.Y) / sc
					w.Main.Position = UDim2.new(
						startPos.X.Scale, startPos.X.Offset + dx,
						startPos.Y.Scale, startPos.Y.Offset + dy
					)
					w:ClampToScreen()
				end,
				stop = function() w:SnapToEdges() end,
			})
		end
	end))

	-- Resize handles (8 directions) -----------------------------
	local MIN_W, MIN_H = 440, 300
	local function beginResize(dir)
		return function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			local startMouse = UserInputService:GetMouseLocation()
			local absPos = w.Main.AbsolutePosition
			local absSize = w.Main.AbsoluteSize
			local L0, T0 = absPos.X, absPos.Y
			local R0, B0 = absPos.X + absSize.X, absPos.Y + absSize.Y
			Drag.begin({
				move = function(x, y)
					local ddx = x - startMouse.X
					local ddy = y - startMouse.Y
					local cam = workspace.CurrentCamera
					local vp = (cam and cam.ViewportSize) or Vector2.new(1920, 1080)
					local sc = math.max(w.Scale.Scale, 0.01)
					local rootOffX = vp.X * (1 - sc) / 2
					local rootOffY = vp.Y * (1 - sc) / 2

					local L, T, R, B = L0, T0, R0, B0
					if dir:find("r") then R = R0 + ddx end
					if dir:find("l") then L = L0 + ddx end
					if dir:find("b") then B = B0 + ddy end
					if dir:find("t") then T = T0 + ddy end

					local minW, minH = MIN_W * sc, MIN_H * sc
					if dir:find("l") and (R - L) < minW then L = R - minW end
					if dir:find("r") and (R - L) < minW then R = L + minW end
					if dir:find("t") and (B - T) < minH then T = B - minH end
					if dir:find("b") and (B - T) < minH then B = T + minH end

					local newW, newH = R - L, B - T
					local cx, cy = (L + R) / 2, (T + B) / 2
					w.Main.Size = UDim2.fromOffset(newW / sc, newH / sc)
					w.Main.Position = UDim2.fromOffset((cx - rootOffX) / sc, (cy - rootOffY) / sc)
				end,
				stop = function() w:ClampToScreen() end,
			})
		end
	end

