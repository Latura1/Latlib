	local function ensureTooltip()
		if tooltip and tooltip.Parent then return end
		tooltip = create("TextLabel", {
			Name = "Tooltip",
			Size = UDim2.fromOffset(0, 22),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = Library.Theme.Bg2,
			BorderSizePixel = 0,
			Text = "",
			Font = Library.Theme.Font,
			TextSize = 12,
			TextColor3 = Library.Theme.Text,
			Visible = false,
			ZIndex = 500,
			Parent = w.Gui,
		})
		corner(tooltip, UDim.new(0, 5))
		stroke(tooltip, Library.Theme.Stroke, 1, 0.3)
		create("UIPadding", {
			PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
			Parent = tooltip,
		})
	end

	function w:_Tooltip(trigger, text)
		if not text or text == "" then return end
		ensureTooltip()
		track(trigger.MouseEnter:Connect(function()
			tooltip.Text = text
			tooltip.Visible = true
		end))
		track(trigger.MouseLeave:Connect(function()
			tooltip.Visible = false
		end))
	end

	track(RunService.RenderStepped:Connect(function()
		if tooltip and tooltip.Visible then
			local m = guiMouse()
			tooltip.Position = UDim2.fromOffset(m.X + 14, m.Y + 16)
		end
	end))

	-- Context menu ----------------------------------------------
	function w:ContextMenu(items, position)
		local cam = workspace.CurrentCamera
		local vp = (cam and cam.ViewportSize) or Vector2.new(1920, 1080)
		local mh = #items * 28 + 12
		local px = math.clamp(position.X, 8, math.max(8, vp.X - 178))
		local py = math.clamp(position.Y, 8, math.max(8, vp.Y - mh - 8))

		local layer = create("TextButton", {
			Name = "ContextLayer",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 400,
			Parent = w.Gui,
		})
		local menu = create("Frame", {
			Name = "ContextMenu",
			Size = UDim2.fromOffset(170, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Position = UDim2.fromOffset(px, py),
			BackgroundColor3 = Library.Theme.Bg2,
			BorderSizePixel = 0,
			ZIndex = 401,
			Parent = layer,
		})
		corner(menu, Library.Theme.RadiusSm)
		stroke(menu, Library.Theme.Stroke, 1, 0.25)
		create("UIListLayout", { Padding = UDim.new(0, 2), Parent = menu })
		pad(menu, 5)

		local function close() layer:Destroy() end

		for _, item in ipairs(items) do
			if item == "-" then
				create("Frame", {
					Size = UDim2.new(1, 0, 0, 1),
					BackgroundColor3 = Library.Theme.Stroke,
					BackgroundTransparency = 0.5,
					BorderSizePixel = 0,
					Parent = menu,
				})
			else
				local b = create("TextButton", {
					Size = UDim2.new(1, 0, 0, 26),
					BackgroundColor3 = Library.Theme.Bg3,
					BackgroundTransparency = 1,
					Text = "  " .. (item.Name or "Item"),
					Font = Library.Theme.Font,
					TextSize = 13,
					TextColor3 = item.Color or Library.Theme.Text,
					TextXAlignment = Enum.TextXAlignment.Left,
					AutoButtonColor = false,
					Parent = menu,
				})
				corner(b, UDim.new(0, 4))
				track(b.MouseEnter:Connect(function() tween(b, 0.1, { BackgroundTransparency = 0.2 }) end))
				track(b.MouseLeave:Connect(function() tween(b, 0.1, { BackgroundTransparency = 1 }) end))
				track(b.MouseButton1Click:Connect(function()
					if item.Callback then task.spawn(item.Callback) end
					close()
				end))
			end
		end

		track(layer.MouseButton1Click:Connect(close))
		return close
	end

