				if btnCfg.Close ~= false then close() end
			end))
		end

		if cfg.Dismissable then
			track(overlay.MouseButton1Click:Connect(close))
		end

		return { Close = close, Box = box }
	end

	-- Watermark -------------------------------------------------
	function w:Watermark(cfg)
		cfg = cfg or {}
		if w._watermark and w._watermark.Frame and w._watermark.Frame.Parent then
			return w._watermark
		end
		local frame = create("Frame", {
			Name = "Watermark",
			Size = UDim2.fromOffset(0, 26),
			AutomaticSize = Enum.AutomaticSize.X,
			Position = UDim2.fromOffset(12, 12),
			BackgroundColor3 = Library.Theme.Bg1,
			BackgroundTransparency = 0.1,
			BorderSizePixel = 0,
			ZIndex = 250,
			Active = true,
			Parent = w.Gui,
		})
		corner(frame, Library.Theme.RadiusSm)
		stroke(frame, Library.Theme.Stroke, 1, 0.3)
		create("UIPadding", {
			PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
			Parent = frame,
		})
		local label = create("TextLabel", {
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			Text = cfg.Text or "LunarUI",
			Font = Library.Theme.FontBold,
			TextSize = 12,
			TextColor3 = cfg.Color or Library.Theme.Primary,
			Parent = frame,
		})

		track(frame.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				local startMouse = UserInputService:GetMouseLocation()
				local startPos = frame.Position
				Drag.begin({
					move = function(x, y)
						local dx = x - startMouse.X
						local dy = y - startMouse.Y
						frame.Position = UDim2.new(
							startPos.X.Scale, startPos.X.Offset + dx,
							startPos.Y.Scale, startPos.Y.Offset + dy
						)
					end,
				})
			end
		end))

		local api = { Frame = frame }
		function api:SetText(t) label.Text = t end
		function api:SetVisible(v) frame.Visible = v ~= false end
		function api:Destroy()
			frame:Destroy()
			if w._watermark == api then w._watermark = nil end
		end
		w._watermark = api
		return api
	end

	-- Scale / Visibility / Unload -------------------------------
	function w:SetScale(value)
		w.Scale.Scale = math.clamp(value or 1, 0.6, 1.6)
		task.defer(function() w:ClampToScreen() end)
	end

	function w:SetAcrylic(level)
		level = math.clamp(tonumber(level) or Library.Theme.WindowOpacity, 0, 0.5)
		Library.Theme.WindowOpacity = level
		Library.Theme.PanelOpacity = math.min(level + 0.08, 0.55)
		if w._applyTheme then w._applyTheme() end
	end

	function w:SetVisible(v)
		v = v ~= false
		if w.Main then w.Main.Visible = v end
		if w._shadow then w._shadow.Visible = v end
		if w._shadowSoft then w._shadowSoft.Visible = v end
	end

	function w:ResetPosition()
		if w.Main then w.Main.Position = UDim2.fromScale(0.5, 0.5) end
		task.defer(function() w:ClampToScreen() end)
	end

	function w:SetWatermarkVisible(v)
		if not w._watermark then
			w:Watermark({ Text = "LunarUI" })
		end
		if w._watermark then w._watermark:SetVisible(v) end
	end

	function w:Unload()
		w._autoSave = false
		for _, c in ipairs(connections) do
			pcall(function() c:Disconnect() end)
		end
		connections = {}
		activeNotifies = {}
		if w.Gui then w.Gui:Destroy() end
		if notifyGui then notifyGui:Destroy() end
		for i, win in ipairs(openWindows) do
			if win == w then table.remove(openWindows, i) break end
		end
	end

	w.Destroy = w.Unload

	openWindows[#openWindows + 1] = w
	return w
end

return Library
